# Web3Forms — email notifications and the fallback sink for signups.
# Already has a working default baked in; set this only to change accounts.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Google Sheets — where competition signups are recorded.
# See docs/COMPETITION_SETUP.md for how to produce these three values.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=1npnsqRojIS3Nu0db8iyi-sEYNUu12Xn5Y2vJFmP8b7M

# SpacetimeDB — the member accounts and competition entries backend.
# The module name published to maincloud.spacetimedb.com. Without it the member
# area renders a plain "not configured" notice instead of failing to build.
NEXT_PUBLIC_STDB_MODULE=
